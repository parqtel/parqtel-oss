# Development Dockerfile for parqtel
FROM rust:1.85-slim AS builder

RUN apt-get update && apt-get install -y protobuf-compiler pkg-config libssl-dev g++ make && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy full workspace (relies on .dockerignore for exclusions)
COPY Cargo.toml Cargo.lock ./
COPY openapi.yaml ./
COPY parqtel-core/ parqtel-core/
COPY parqtel-ingest/ parqtel-ingest/
COPY parqtel-query/ parqtel-query/
COPY parqtel-alert/ parqtel-alert/
COPY parqtel-pipeline/ parqtel-pipeline/
COPY parqtel-server/ parqtel-server/
COPY parqtel-mcp-core/ parqtel-mcp-core/
COPY parqtel-mcp-slack/ parqtel-mcp-slack/
COPY parqtel-mcp-pagerduty/ parqtel-mcp-pagerduty/
COPY parqtel-mcp-jira/ parqtel-mcp-jira/
COPY parqtel-mcp-notion/ parqtel-mcp-notion/
COPY parqtel-mcp-discord/ parqtel-mcp-discord/
COPY parqtel-mcp-gdocs/ parqtel-mcp-gdocs/
COPY parqtel-mcp-parqtel/ parqtel-mcp-parqtel/

RUN cargo build --release --package parqtel-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y curl jq && rm -rf /var/lib/apt/lists/*

WORKDIR /var/lib/parqtel
COPY --from=builder /app/target/release/parqtel /parqtel

ENV RUST_LOG=info
EXPOSE 9090

ENTRYPOINT ["/parqtel"]
CMD ["serve"]
