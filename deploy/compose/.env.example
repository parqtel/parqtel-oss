# ─────────────────────────────────────────────────────────────────────────────
# Parqtel — Docker Compose Environment Variables
# Copy to .env and customize: cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────────────────────
PARQTEL_PORT=9090
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091

# ── Parqtel ──────────────────────────────────────────────────────────────────
RUST_LOG=info

# ── Load Generator ───────────────────────────────────────────────────────────
LOAD_TEST_MODE=false
GENERATOR_NORMAL_SERIES=1000
GENERATOR_NORMAL_RPS=167

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=parqtel-dev

# ── MCP Integrations (leave empty to disable) ────────────────────────────────
SLACK_BOT_TOKEN=
PAGERDUTY_API_KEY=
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
NOTION_API_KEY=
DISCORD_BOT_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
