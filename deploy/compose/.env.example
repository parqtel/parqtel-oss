# parqtel Local Development Environment Variables

# Host path for parqtel data persistence (optional, default is named volume)
# PARQTEL_DATA_DIR=./data

# Scaling for load generator in NORMAL mode
GENERATOR_NORMAL_SERIES=1000
GENERATOR_NORMAL_RPS=167

# Scaling for load generator in LOAD TEST mode
GENERATOR_LOAD_SERIES=10000
GENERATOR_LOAD_RPS=17000

# Grafana admin credentials
GRAFANA_ADMIN_PASSWORD=parqtel-dev

# Host path for load test CSV results
LOAD_TEST_RESULTS_DIR=./results
