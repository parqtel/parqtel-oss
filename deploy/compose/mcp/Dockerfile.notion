# Build stage
FROM rust:1.79-slim AS builder

WORKDIR /build

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates/parqtel-mcp-core crates/parqtel-mcp-core
COPY crates/parqtel-mcp-notion crates/parqtel-mcp-notion

# Build release
RUN cargo build --release --bin parqtel-mcp-notion

# Final stage
FROM gcr.io/distroless/cc-debian12

WORKDIR /app

COPY --from=builder /build/target/release/parqtel-mcp-notion /app/parqtel-mcp-notion

EXPOSE 3000

CMD ["/app/parqtel-mcp-notion"]
