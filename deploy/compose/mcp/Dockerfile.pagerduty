FROM rust:1.85-slim AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y pkg-config libssl-dev g++ make && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY parqtel-mcp-core/ parqtel-mcp-core/
COPY parqtel-mcp-pagerduty/ parqtel-mcp-pagerduty/
RUN cargo build --release --bin parqtel-mcp-pagerduty

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/parqtel-mcp-pagerduty /app/parqtel-mcp-pagerduty
EXPOSE 3000
CMD ["/app/parqtel-mcp-pagerduty"]
