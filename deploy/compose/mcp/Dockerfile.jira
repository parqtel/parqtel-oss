FROM rust:1.85-slim AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y pkg-config libssl-dev g++ make && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY parqtel-mcp-core/ parqtel-mcp-core/
COPY parqtel-mcp-jira/ parqtel-mcp-jira/
RUN cargo build --release --bin parqtel-mcp-jira

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/parqtel-mcp-jira /app/parqtel-mcp-jira
EXPOSE 3000
CMD ["/app/parqtel-mcp-jira"]
