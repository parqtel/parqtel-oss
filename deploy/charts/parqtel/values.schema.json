{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "parqtel Helm Chart Values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "replicaCount", "storage", "parqtel"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": { "type": "array" }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "type": "integer" },
        "annotations": { "type": "object" },
        "nodePort": { "type": ["string", "integer"] }
      }
    },
    "strategy": { "type": "object" },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "size"],
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "pattern": "^[0-9]+(Gi|Ti)$" },
        "storageClassName": { "type": "string" },
        "accessMode": { "type": "string" },
        "existingClaim": { "type": "string" }
      }
    },
    "parqtel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": { "type": "object" },
        "storage": {
          "type": "object",
          "properties": {
            "compression": {
              "type": "string",
              "enum": ["zstd", "snappy", "lz4", "none"]
            }
          }
        },
        "ingest": { "type": "object" },
        "query": { "type": "object" },
        "ui": { "type": "object" },
        "telemetry": { "type": "object" }
      }
    },
    "autoscaling": { "type": "object" },
    "podDisruptionBudget": { "type": "object" },
    "networkPolicy": { "type": "object" },
    "metrics": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "initContainers": { "type": "array" },
    "sidecars": { "type": "array" },
    "lifecycle": { "type": "object" },
    "kube-prometheus-stack": { "type": "object" },
    "cert-manager": { "type": "object" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port", "tlsSecretName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "externalMetrics": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "port": { "type": "integer" },
        "cacheExpirySecs": { "type": "integer" },
        "queryTimeoutSecs": { "type": "integer" },
        "maxConcurrent": { "type": "integer" },
        "tlsSecretName": { "type": "string" },
        "resources": { "type": "object" }
      }
    }
  }
}
