# ─────────────────────────────────────────────────────────────────────────────
# Parqtel — Docker Compose Environment Variables
# Copy to .env and customize: cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────────────────────
PARQTEL_PORT=9090
# OTLP gRPC ingestion port (OTel SDK default). Set PARQTEL_GRPC_PORT= to hide it.
PARQTEL_GRPC_PORT=4317
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091

# ── Parqtel ──────────────────────────────────────────────────────────────────
RUST_LOG=info

# ── Load Generator ───────────────────────────────────────────────────────────
LOAD_TEST_MODE=false
GENERATOR_NORMAL_SERIES=1000
GENERATOR_NORMAL_RPS=167

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=parqtel-dev

# ── MCP ──────────────────────────────────────────────────────────────────────
# The Parqtel MCP server (port 3007) queries this instance's API.
MCP_PARQTEL_PORT=3007
MCP_RATE_LIMIT=600
PARQTEL_API_URL=http://parqtel:9090
